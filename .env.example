CARTESIA_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# PEEK_MODEL=claude-sonnet-5-5
# PEEK_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b
# PEEK_SOURCE=camera            # or "mouse" to use the pointer as your gaze
# PEEK_REQUIRE_WAKE_WORD=true   # false = every sentence you say is a command
# PEEK_WAKE_WORDS=peek,hey computer
# PEEK_SEND_SCREENSHOT=true     # attach a crop around your gaze (needs Screen Recording)
# PEEK_HIGHLIGHT=true           # outline the control or text you're looking at in blue
# PEEK_CAMERA=0
# PEEK_NOISE_GATE_DB=12         # how much louder than the room you must be; higher ignores more, 0 = off
# PEEK_BARGE_IN=true            # keep the mic on while Peek talks so you can interrupt it
# PEEK_CONVERSATION_S=15        # seconds Peek keeps listening without the wake word after an exchange
# PEEK_SOUNDS=true              # tink when a conversation starts, pop when it ends
